<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.ai-homelab.file-intelligence</string>
  <key>ProgramArguments</key><array><string>__REPOSITORY_ROOT__/scripts/file-intelligence-scheduled</string></array>
  <key>WorkingDirectory</key><string>__REPOSITORY_ROOT__</string>
  <key>StartCalendarInterval</key><dict><key>Minute</key><integer>20</integer></dict>
  <key>ProcessType</key><string>Background</string>
  <key>Umask</key><integer>63</integer>
  <key>LowPriorityIO</key><true/>
  <key>Nice</key><integer>5</integer>
  <key>StandardOutPath</key><string>__REPOSITORY_ROOT__/.state/file-intelligence/logs/launchd.out.log</string>
  <key>StandardErrorPath</key><string>__REPOSITORY_ROOT__/.state/file-intelligence/logs/launchd.err.log</string>
</dict></plist>
