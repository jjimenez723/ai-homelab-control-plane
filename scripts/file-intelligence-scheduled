#!/usr/bin/env bash
# launchd has a sparse environment. Keep this wrapper explicit and shell-free.
#
# This is a one-shot invocation: launchd starts it, it triages once, it exits.
# There is no daemon and no watcher here. `--automated` tells the CLI it is
# running unattended, so it must use the long automation settle window rather
# than the short window a human-initiated run is allowed to use.
set -euo pipefail
export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT_DIR"
PYTHON="$ROOT_DIR/.venv/bin/python3"
[[ -x "$PYTHON" ]] || PYTHON="/usr/bin/python3"
exec "$PYTHON" -m tools.ingest.cli triage all --apply --automated
