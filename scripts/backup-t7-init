#!/usr/bin/env bash
# Idempotent initialization of only the dedicated Google Drive repository.
set -euo pipefail
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT_DIR"
PYTHON="$ROOT_DIR/.venv/bin/python3"; [[ -x "$PYTHON" ]] || PYTHON="python3"
exec "$PYTHON" -m tools.backup_cli init "$@"
