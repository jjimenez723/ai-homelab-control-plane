#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PACKAGE_DIR="$ROOT_DIR/macos/AngelApp"
BUILD_DIR="${ANGEL_BUILD_DIR:-$ROOT_DIR/build/angel-swift}"
APP_DIR="${ANGEL_APP_DIR:-$ROOT_DIR/build/Angel.app}"
SIGNING_IDENTITY="${SIGNING_IDENTITY:-}"

swift build -c release --package-path "$PACKAGE_DIR" --build-path "$BUILD_DIR" --product AngelApp

rm -rf "$APP_DIR"
mkdir -p "$APP_DIR/Contents/MacOS" "$APP_DIR/Contents/Resources"
cp "$BUILD_DIR/release/AngelApp" "$APP_DIR/Contents/MacOS/AngelApp"
cp "$PACKAGE_DIR/Resources/Info.plist" "$APP_DIR/Contents/Info.plist"
cp "$PACKAGE_DIR/Resources/AppIcon.icns" "$APP_DIR/Contents/Resources/AppIcon.icns"
chmod 755 "$APP_DIR/Contents/MacOS/AngelApp"

if [[ -n "$SIGNING_IDENTITY" ]]; then
  codesign --force --options runtime --timestamp --sign "$SIGNING_IDENTITY" "$APP_DIR"
else
  codesign --force --deep --sign - "$APP_DIR"
fi

codesign --verify --deep --strict "$APP_DIR"
echo "$APP_DIR"
