#!/usr/bin/env bash
# Thin wrapper around `python -m tools.campaign.cli` -- the deterministic,
# unattended evaluation-campaign command. See docs/22-evaluation-campaign.md.
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT_DIR"

if [[ -x "$ROOT_DIR/.venv/bin/python3" ]]; then
  PYTHON="$ROOT_DIR/.venv/bin/python3"
else
  PYTHON="python3"
fi

exec "$PYTHON" -m tools.campaign.cli "$@"
