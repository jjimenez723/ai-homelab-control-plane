#!/usr/bin/env bash
# Regenerate the development-repository inventory (PLAN.md Phase 1).
#
# READ-ONLY over every repository it inspects: it never moves, deletes,
# fetches, pushes, or prunes anything. It writes exactly two files,
# `unpushed-repos.md` and `repos-inventory.yaml`, into the report directory.
# With no --report-dir it writes to 90-system/migration-reports/ on the
# UUID-verified Angel volume and refuses if that volume is not mounted.
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT_DIR"

if [[ -x "$ROOT_DIR/.venv/bin/python3" ]]; then
  PYTHON="$ROOT_DIR/.venv/bin/python3"
else
  PYTHON="python3"
fi

exec "$PYTHON" -m tools.ingest.cli repos-report "$@"
