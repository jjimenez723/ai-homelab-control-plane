#!/usr/bin/env bash
# Refresh Angel's read-only copy of the trusted Git `skills/` tree at
# `40-ai/skills/trusted/`, with a MANIFEST.yaml of sha256 plus the git SHA
# it was taken from.
#
# Git is the source of truth. This export is a verifiable record, not a load
# path, and editing it changes nothing (docs/26-skills-and-knowledge-trust.md).
# The volume is resolved by APFS UUID through `tools/ingest/t7.py` first.
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT_DIR"

if [[ -x "$ROOT_DIR/.venv/bin/python3" ]]; then
  PYTHON="$ROOT_DIR/.venv/bin/python3"
else
  PYTHON="python3"
fi

exec "$PYTHON" -m tools.angel_sync skills "$@"
