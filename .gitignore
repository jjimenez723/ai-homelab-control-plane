# This repo holds control-plane design docs and the tooling that implements them; data, media, secrets, and machine-specific config stay out.
.DS_Store
.env
.env.*
*.key
*.pem
*.p12
*.pfx
secrets/
credentials/
private/
artifacts/
generated/
build/
dist/
macos/AngelApp/.build/
tmp/
models/
# The source registry package is tracked; model weights remain ignored above.
!tools/models/
!tools/models/**
datasets/
media/
client-data/

# Local pipeline environments and derived knowledge artifacts.
.venv/
knowledge/

# Machine-specific ingestion config (T7 UUID, real Desktop/Documents/Downloads
# paths, registered SD UUIDs). Commit config/ingest.example.yaml instead.
config/ingest.yaml
# Measured model-role certifications (D-042, D-060). Machine-specific: a
# certification names the exact local model digest/quantization that was
# measured on this host, so it is local state, not a repository claim. The
# empty `config/certifications.example.yaml` stays committed and stays empty
# (tests/test_autonomous_routing.py), and the content of any real record is
# reproduced in DECISIONS.md where it can be reviewed.
config/certifications.yaml
# Local ingest catalog/sidecars/staging when a dev T7 root lives in-repo.
90-system/
# The generic `media/` ignore above (for local media dumps) would otherwise
# also swallow this source package.
!tools/ingest/media/
!tools/ingest/media/**
# Legacy candidate-skill location; video-derived skills are untrusted and never belong in skills/.
skills/candidates/
extraction/
work/
__pycache__/
.pytest_cache/
.state/
*.part

# Common model-weight formats.
*.bin
*.ckpt
*.onnx
*.pt
*.pth
*.safetensors

# Client media files outside ignored media directories.
*.avi
*.mov
*.mp3
*.mp4
*.wav
*.webm

# Agent worktrees created by Claude Code during integration passes; never source.
.claude/worktrees/

# Machine-local model registry (exact local tags/digests measured on this host);
# config/models.example.yaml is the committed template.
config/models.yaml
